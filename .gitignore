# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference scrape of techatnyu.org (never commit or ship)
/reference/
# QA artifacts
/qa/screenshots/
/qa/lighthouse/
/qa/__pycache__/

# Satoshi (ITF Free Font License): self-hosting on the site is allowed, but the
# font must not be redistributed via a public repository, so it is not committed.
# Get it from https://www.fontshare.com/fonts/satoshi (Fonts/WEB/fonts/Satoshi-Bold.woff2)
# and copy it into public/fonts/ before building.
public/fonts/Satoshi-*
